# AJH Enterprises — environment variables
#
# Copy this file to `.env.local` for local development, and set the same
# variables in your Vercel project settings for production/preview deploys.
# See README.md for full setup instructions.

# Resend (https://resend.com) API key used to send contact form submissions.
RESEND_API_KEY=

# The email address contact form submissions are sent TO (your inbox).
CONTACT_TO_EMAIL=hello@ajhenterprises.com

# The email address contact form submissions are sent FROM.
# This must be an address on a domain you've verified with Resend.
CONTACT_FROM_EMAIL=contact@ajhenterprises.com
